{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "asp",
  "wire_encoding": "postcard-serde-length-prefixed",
  "protocol_version": 17,
  "supported_protocol_versions": [16, 17],
  "max_frame_bytes": 134217728,
  "features": [
    "resume_stream",
    "file_stream",
    "file_upload_resume",
    "workspace_state",
    "pty_datagram",
    "principal_scopes",
    "event_subscriptions",
    "port_forward",
    "exec_summary",
    "process_log_stream",
    "file_preconditions",
    "workspace_index",
    "workspace_digest",
    "artifact_stream"
  ],
  "optional_features": ["event_consumer_leases", "pty_rich_state", "pty_rich_compression", "file_patch_ranges", "pty_state_delta", "pty_scrollback"],
  "errors": [
    {"code":"authentication_required","retryable":false},
    {"code":"authentication_failed","retryable":false},
    {"code":"authentication_revoked","retryable":false},
    {"code":"forbidden","retryable":false},
    {"code":"server_busy","retryable":true},
    {"code":"principal_byte_budget","retryable":true},
    {"code":"principal_response_budget","retryable":true},
    {"code":"principal_connection_limit","retryable":true},
    {"code":"principal_request_stream_limit","retryable":true},
    {"code":"invalid_cursor","retryable":false},
    {"code":"invalid_ack","retryable":false},
    {"code":"unsupported_feature","retryable":false},
    {"code":"invalid_signal","retryable":false},
    {"code":"unknown_process","retryable":false},
    {"code":"process_not_running","retryable":false},
    {"code":"process_spawn_failed","retryable":false},
    {"code":"file_not_found","retryable":false},
    {"code":"invalid_path","retryable":false},
    {"code":"invalid_range","retryable":false},
    {"code":"file_changed","retryable":true},
    {"code":"file_too_large","retryable":false},
    {"code":"invalid_sha256","retryable":false},
    {"code":"invalid_patch","retryable":false},
    {"code":"precondition_required","retryable":false},
    {"code":"version_conflict","retryable":false},
    {"code":"idempotency_conflict","retryable":false},
    {"code":"idempotency_capacity","retryable":false},
    {"code":"invalid_chunk","retryable":false},
    {"code":"invalid_offset","retryable":false},
    {"code":"incomplete_upload","retryable":true},
    {"code":"upload_staging_failed","retryable":true},
    {"code":"invalid_pty_size","retryable":false},
    {"code":"pty_unavailable","retryable":false},
    {"code":"artifact_not_found","retryable":false},
    {"code":"artifact_too_large","retryable":false},
    {"code":"artifact_hash_mismatch","retryable":false},
    {"code":"artifact_quota","retryable":false},
    {"code":"invalid_artifact_id","retryable":false},
    {"code":"invalid_artifact_name","retryable":false},
    {"code":"artifact_error","retryable":true}
  ],
  "operations": [
    {"name":"hello","wire_name":"HELLO","transport":"stream","scope":null,"idempotency":"safe_retry"},
    {"name":"hello_features","wire_name":"HELLO_FEATURES","transport":"stream","scope":null,"idempotency":"safe_retry"},
    {"name":"health","wire_name":"HEALTH","transport":"stream","scope":"health:read","idempotency":"read_only"},
    {"name":"open_session","wire_name":"OPEN_SESSION","transport":"stream","scope":"session:create","idempotency":"request_id"},
    {"name":"resume_session","wire_name":"RESUME_SESSION","transport":"stream","scope":"session:read","idempotency":"read_only"},
    {"name":"resume_session_stream","wire_name":"RESUME_SESSION_STREAM","transport":"stream","scope":"session:read","idempotency":"read_only"},
    {"name":"ack_events","wire_name":"ACK_EVENTS","transport":"stream","scope":"session:read","idempotency":"read_only"},
    {"name":"ack_events_consumer","wire_name":"ACK_EVENTS_CONSUMER","transport":"stream","scope":"session:read","idempotency":"read_only"},
    {"name":"subscribe_events","wire_name":"SUBSCRIBE_EVENTS","transport":"stream","scope":"session:read","idempotency":"cursor_read"},
    {"name":"exec","wire_name":"EXEC","transport":"stream","scope":"process:execute","idempotency":"request_id"},
    {"name":"exec_summary","wire_name":"EXEC_SUMMARY","transport":"stream","scope":"process:execute","idempotency":"request_id"},
    {"name":"process_output_stream","wire_name":"PROCESS_OUTPUT_STREAM","transport":"stream","scope":"process:read","idempotency":"range_read"},
    {"name":"process_state","wire_name":"PROCESS_STATE","transport":"stream","scope":"process:read","idempotency":"read_only"},
    {"name":"spawn","wire_name":"SPAWN","transport":"stream","scope":"process:execute","idempotency":"request_id"},
    {"name":"signal","wire_name":"SIGNAL","transport":"stream","scope":"process:signal","idempotency":"request_id"},
    {"name":"pty_open","wire_name":"PTY_OPEN","transport":"stream","scope":"pty:use","idempotency":"attachment"},
    {"name":"pty_input","wire_name":"PTY_INPUT","transport":"stream","scope":"pty:use","idempotency":"ordered_attachment"},
    {"name":"pty_input_sequenced","wire_name":"PTY_INPUT_SEQUENCED","transport":"stream","scope":"pty:use","idempotency":"sequence_ack"},
    {"name":"pty_resize","wire_name":"PTY_RESIZE","transport":"stream","scope":"pty:use","idempotency":"latest_attachment_state"},
    {"name":"file_get","wire_name":"FILE_GET","transport":"stream","scope":"file:read","idempotency":"read_only"},
    {"name":"file_get_stream","wire_name":"FILE_GET_STREAM","transport":"stream","scope":"file:read","idempotency":"range_read"},
    {"name":"file_put","wire_name":"FILE_PUT","transport":"stream","scope":"file:write","idempotency":"request_id"},
    {"name":"file_put_stream_begin","wire_name":"FILE_PUT_STREAM_BEGIN","transport":"stream","scope":"file:write","idempotency":"staged_request_id"},
    {"name":"file_put_stream_resume_begin","wire_name":"FILE_PUT_STREAM_RESUME_BEGIN","transport":"stream","scope":"file:write","idempotency":"staged_request_id"},
    {"name":"file_put_stream_chunk","wire_name":"FILE_PUT_STREAM_CHUNK","transport":"stream","scope":"file:write","idempotency":"ordered_upload"},
    {"name":"file_put_stream_end","wire_name":"FILE_PUT_STREAM_END","transport":"stream","scope":"file:write","idempotency":"ordered_upload"},
    {"name":"file_patch","wire_name":"FILE_PATCH","transport":"stream","scope":"file:write","idempotency":"hash_guarded_request_id"},
    {"name":"file_patch_ranges","wire_name":"FILE_PATCH_RANGES","transport":"stream","scope":"file:write","idempotency":"hash_guarded_request_id"},
    {"name":"workspace_state","wire_name":"WORKSPACE_STATE","transport":"stream","scope":"workspace:read","idempotency":"read_only"},
    {"name":"port_open","wire_name":"PORT_OPEN","transport":"stream","scope":"ports:open","idempotency":"live_tunnel"},
    {"name":"artifact_get_stream","wire_name":"ARTIFACT_GET_STREAM","transport":"stream","scope":"artifact:read","idempotency":"range_read"},
    {"name":"artifact_put_stream_begin","wire_name":"ARTIFACT_PUT_STREAM_BEGIN","transport":"stream","scope":"artifact:write","idempotency":"staged_request_id"},
    {"name":"artifact_put_stream_resume_begin","wire_name":"ARTIFACT_PUT_STREAM_RESUME_BEGIN","transport":"stream","scope":"artifact:write","idempotency":"staged_request_id"},
    {"name":"artifact_put_stream_chunk","wire_name":"ARTIFACT_PUT_STREAM_CHUNK","transport":"stream","scope":"artifact:write","idempotency":"ordered_upload"},
    {"name":"artifact_put_stream_end","wire_name":"ARTIFACT_PUT_STREAM_END","transport":"stream","scope":"artifact:write","idempotency":"ordered_upload"}
  ],
  "compatibility": {
    "version_negotiation": "HELLO_FEATURES",
    "unknown_version": "fail_closed",
    "unknown_feature": "ignore_and_do_not_send",
    "deprecation_policy": "see docs/SCHEMA.md",
    "mixed_release_matrix": "required_before_v1"
  }
}
